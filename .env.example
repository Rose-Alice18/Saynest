# Copy this file to .env and fill in the keys you have.
# Every key is optional. AI providers are tried in this order, and if none
# are set (or all are busy) SayNest falls back to the free Dictionary API.

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OpenAI (paid backup, only used when Gemini is unavailable):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional: override the OpenAI model (default: gpt-6-luna)
# OPENAI_MODEL="gpt-6-luna"
